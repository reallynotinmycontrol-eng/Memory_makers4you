# ---- Database & cache ------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/craftstore
REDIS_URL=redis://localhost:6379
# Turn on on a VPS / production server (needs Redis running)
USE_REDIS_MODULES=false

# ---- Security (change these to long random strings in production) ----------
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ---- CORS: where the storefront and admin are served from -------------------
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Public URL of this backend (used by the admin dashboard)
MEDUSA_BACKEND_URL=http://localhost:9000

# ---- Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys)
# Use test keys (rzp_test_...) until you go live. Leave empty to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set when you add a webhook in Razorpay pointing to
# https://YOUR-BACKEND/hooks/payment/razorpay_razorpay
RAZORPAY_WEBHOOK_SECRET=
