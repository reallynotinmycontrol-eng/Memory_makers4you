# Where your Medusa backend runs
MEDUSA_BACKEND_URL=http://localhost:9000

# Printed at the end of `npm run setup` in apps/backend
# (also in Admin → Settings → Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public URL of this storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Country used in URLs (/in/...). Keep "in" for India.
NEXT_PUBLIC_DEFAULT_REGION=in

# Fallback store name (the name set in Admin → Storefront → Settings wins)
NEXT_PUBLIC_STORE_NAME=My Craft Store

# Change this to a long random string
REVALIDATE_SECRET=supersecret

# Optional: extra image hosts, comma separated (e.g. your S3 / R2 bucket domain)
IMAGE_HOSTS=

# Medusa Cloud only: your Cloud S3 hostname and pathname for images
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
